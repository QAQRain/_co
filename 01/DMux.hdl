/**
 * Demultiplexor:
 * {a, b} = {in, 0} if sel == 0
 *          {0, in} if sel == 1
 */

CHIP DMux {
    IN in, sel;
    OUT a, b;

    PARTS:
    // Put your code here:
    // 1. 反轉選擇訊號
    Not(in=sel, out=notSel);

    // 2. 當 sel 為 0 時，a = in AND 1 (即 in)；當 sel 為 1 時，a = in AND 0 (即 0)
    And(a=in, b=notSel, out=a);

    // 3. 當 sel 為 1 時，b = in AND 1 (即 in)；當 sel 為 0 時，b = in AND 0 (即 0)
    And(a=in, b=sel, out=b);
}
