// 系統服務：啟動、結束、錯誤處理、等待
class Sys {
    function void init() {
        do Memory.init();
        do Screen.init();
        do Output.init();
        do Main.main();
        do Sys.halt();
        return;
    }

    function void halt() {
        while (true) {
        }
        return;
    }

    function void error(int errorCode) {
        do Output.printString("Err:");
        do Output.printInt(errorCode);
        do Sys.halt();
        return;
    }

    function void wait(int duration) {
        var int i;
        var int j;
        let i = 0;
        while (i < duration) {
            let j = 0;
            while (j < 500) {
                let j = j + 1;
            }
            let i = i + 1;
        }
        return;
    }
}
