// File name: projects/02/HalfAdder.hdl

/**
 * Computes the sum of two bits.
 */

CHIP HalfAdder {
    IN a, b;    // 1-bit inputs
    OUT sum,    // Right bit of a + b 
        carry;  // Left bit of a + b

    PARTS:
    // Put you code here:
        // 1. sum 為 Xor 邏輯
    Xor(a=a, b=b, out=sum);

    // 2. carry 為 And 邏輯
    And(a=a, b=b, out=carry);
}
