/**
 * 16-bit incrementer:
 * out = in + 1 (arithmetic addition)
 */

CHIP Inc16 {
    IN in[16];
    OUT out[16];

    PARTS:
   // Put you code here:
   // 將輸入 in 與數字 1 (b[0]=true) 相加
    Add16(a=in, b[0]=true, out=out);
}